<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Units Window Action -->
    <record id="action_property_unit" model="ir.actions.act_window">
        <field name="name">Units &amp; Parking Slots</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_property_unit', '=', True)]</field>
        <field name="context">{'default_is_property_unit': True, 'default_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create or manage your Property Units &amp; Parking Slots!
            </p>
        </field>
    </record>
</odoo>
