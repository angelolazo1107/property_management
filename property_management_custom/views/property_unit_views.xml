<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Buildings Views -->
    <record id="view_property_building_tree" model="ir.ui.view">
        <field name="name">property.building.tree</field>
        <field name="model">property.building</field>
        <field name="arch" type="xml">
            <tree string="Buildings &amp; Towers">
                <field name="name"/>
                <field name="code"/>
                <field name="total_floors"/>
                <field name="total_units"/>
                <field name="address"/>
            </tree>
        </field>
    </record>

    <record id="view_property_building_form" model="ir.ui.view">
        <field name="name">property.building.form</field>
        <field name="model">property.building</field>
        <field name="arch" type="xml">
            <form string="Building / Tower">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Alon Tower A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="total_floors"/>
                            <field name="total_units"/>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="notes" placeholder="Building amenities, security protocols..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Property Units Views -->
    <record id="view_property_unit_tree" model="ir.ui.view">
        <field name="name">property.unit.tree</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <tree string="Property Units">
                <field name="name"/>
                <field name="building_id"/>
                <field name="floor"/>
                <field name="unit_type"/>
                <field name="area_sqm"/>
                <field name="monthly_rate"/>
                <field name="status"/>
                <field name="current_tenant_id"/>
            </tree>
        </field>
    </record>

    <record id="view_property_unit_form" model="ir.ui.view">
        <field name="name">property.unit.form</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <form string="Property Unit">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,reserved,occupied,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Unit 101"/></h1>
                    </div>
                    <group>
                        <group string="Unit Specifications">
                            <field name="building_id"/>
                            <field name="floor"/>
                            <field name="unit_type"/>
                            <field name="area_sqm"/>
                            <field name="monthly_rate"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Utility Meters &amp; Tenant">
                            <field name="current_tenant_id"/>
                            <field name="electricity_meter_no"/>
                            <field name="water_meter_no"/>
                            <field name="latest_electric_reading"/>
                            <field name="latest_water_reading"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Unit Details">
                            <field name="notes" placeholder="Features, inclusions, furnishings..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_property_building" model="ir.actions.act_window">
        <field name="name">Buildings &amp; Towers</field>
        <field name="res_model">property.building</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_property_unit" model="ir.actions.act_window">
        <field name="name">Property Units</field>
        <field name="res_model">property.unit</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
