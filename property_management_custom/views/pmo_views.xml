<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PMO Job Order Form View -->
    <record id="view_pmo_job_order_form" model="ir.ui.view">
        <field name="name">pmo.job.order.form</field>
        <field name="model">pmo.job.order</field>
        <field name="arch" type="xml">
            <form string="PMO Job Order">
                <header>
                    <button name="action_approve_waiver" string="Approve Payment Waiver (GM)" type="object" class="btn-warning" invisible="management_waiver_approved or not is_chargeable"/>
                    <button name="action_schedule_mst" string="Schedule MST Maintenance" type="object" class="btn-primary" invisible="stage == 'scheduled' or stage == 'completed'"/>
                    <field name="stage" widget="statusbar" statusbar_visible="intake,admin_review,tenant_approval,payment_pending,scheduled,in_progress,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Job Request Origin">
                            <field name="unit_id"/>
                            <field name="tenant_id"/>
                            <field name="helpdesk_ticket_id"/>
                            <field name="category"/>
                        </group>
                        <group string="Costing &amp; Payment Controls">
                            <field name="is_chargeable"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="job_cost" invisible="not is_chargeable"/>
                            <field name="payment_verified"/>
                            <field name="management_waiver_approved"/>
                        </group>
                    </group>
                    <group string="MST Scheduling &amp; Execution">
                        <group>
                            <field name="scheduled_date"/>
                            <field name="assigned_technician_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope of Work &amp; Completion Evidence" name="work_details">
                            <group>
                                <field name="work_description" placeholder="Describe scope of work, materials required, and diagnostic observations..."/>
                                <field name="completion_photos" widget="image"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- PMO Job Order Tree View -->
    <record id="view_pmo_job_order_tree" model="ir.ui.view">
        <field name="name">pmo.job.order.tree</field>
        <field name="model">pmo.job.order</field>
        <field name="arch" type="xml">
            <list string="PMO Job Orders">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="category"/>
                <field name="is_chargeable"/>
                <field name="payment_verified"/>
                <field name="management_waiver_approved"/>
                <field name="stage" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Utility Reading Form View -->
    <record id="view_pmo_utility_reading_form" model="ir.ui.view">
        <field name="name">pmo.utility.reading.form</field>
        <field name="model">pmo.utility.reading</field>
        <field name="arch" type="xml">
            <form string="Utility Reading Entry">
                <header>
                    <button name="action_verify_reading" string="Verify Reading" type="object" class="btn-primary" invisible="status == 'verified'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,verified,billed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Meter &amp; Tenant Unit">
                            <field name="unit_id"/>
                            <field name="tenant_id"/>
                            <field name="meter_type"/>
                            <field name="reading_date"/>
                        </group>
                        <group string="Consumption &amp; Amount">
                            <field name="previous_reading"/>
                            <field name="current_reading"/>
                            <field name="consumption"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="rate_per_unit"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- PMO Job Order Graph View -->
    <record id="view_pmo_job_order_graph" model="ir.ui.view">
        <field name="name">pmo.job.order.graph</field>
        <field name="model">pmo.job.order</field>
        <field name="arch" type="xml">
            <graph string="PMO Job Orders Analysis" type="bar">
                <field name="category" type="row"/>
                <field name="job_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- PMO Job Order Pivot View -->
    <record id="view_pmo_job_order_pivot" model="ir.ui.view">
        <field name="name">pmo.job.order.pivot</field>
        <field name="model">pmo.job.order</field>
        <field name="arch" type="xml">
            <pivot string="PMO Job Orders Pivot Analysis">
                <field name="category" type="row"/>
                <field name="stage" type="col"/>
                <field name="job_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- PMO Job Order Window Action -->
    <record id="action_pmo_job_order" model="ir.actions.act_window">
        <field name="name">PMO Job Orders</field>
        <field name="res_model">pmo.job.order</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>

    <!-- PMO Utility Reading Window Action -->
    <record id="action_pmo_utility_reading" model="ir.actions.act_window">
        <field name="name">PMO Utility Meter Readings</field>
        <field name="res_model">pmo.utility.reading</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
