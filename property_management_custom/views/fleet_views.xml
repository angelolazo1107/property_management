<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fleet Trip Request Form View -->
    <record id="view_fleet_trip_request_form" model="ir.ui.view">
        <field name="name">fleet.trip.request.form</field>
        <field name="model">fleet.trip.request</field>
        <field name="arch" type="xml">
            <form string="Vehicle Request &amp; Trip Log">
                <header>
                    <button name="action_complete_trip" string="Complete Trip" type="object" class="btn-primary" invisible="status == 'completed' or status == 'verified'"/>
                    <button name="action_verify_trip" string="Verify Collection &amp; Close (Accounting)" type="object" class="btn-success" invisible="accounting_verified"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,approved,in_progress,completed,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Trip Info &amp; Destination Consolidation">
                            <field name="passenger_name"/>
                            <field name="destination_area"/>
                            <field name="trip_category" widget="radio"/>
                            <field name="purpose"/>
                        </group>
                        <group string="Assigned Asset &amp; Driver">
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    <group string="Special Client Billing &amp; GSD Collection">
                        <group>
                            <field name="is_chargeable"/>
                            <field name="chargeable_tenant_id" invisible="not is_chargeable"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="trip_fee" invisible="not is_chargeable"/>
                            <field name="gsd_ar_number" invisible="not is_chargeable"/>
                        </group>
                        <group>
                            <field name="accounting_verified"/>
                        </group>
                    </group>
                    <group string="Odometer Log (Mileage Start &amp; End)">
                        <group>
                            <field name="mileage_start"/>
                            <field name="mileage_end"/>
                            <field name="total_km"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Driver Trip Record &amp; Remarks" name="log">
                            <field name="driver_trip_log" placeholder="Driver log of route, traffic delays, fuel receipts, or incidents..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Fleet Trip Request Tree View -->
    <record id="view_fleet_trip_request_tree" model="ir.ui.view">
        <field name="name">fleet.trip.request.tree</field>
        <field name="model">fleet.trip.request</field>
        <field name="arch" type="xml">
            <list string="Vehicle Trips">
                <field name="name"/>
                <field name="passenger_name"/>
                <field name="destination_area"/>
                <field name="trip_category"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="total_km"/>
                <field name="accounting_verified"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Fleet Trip Request Action -->
    <record id="action_fleet_trip_request" model="ir.actions.act_window">
        <field name="name">Vehicle Requests &amp; Trip Logs</field>
        <field name="res_model">fleet.trip.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
