<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_trip_request_tree" model="ir.ui.view">
        <field name="name">fleet.trip.request.tree</field>
        <field name="model">fleet.trip.request</field>
        <field name="arch" type="xml">
            <tree string="Fleet Trip Records">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="passenger_name"/>
                <field name="purpose"/>
                <field name="total_km"/>
                <field name="is_chargeable"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_fleet_trip_request_form" model="ir.ui.view">
        <field name="name">fleet.trip.request.form</field>
        <field name="model">fleet.trip.request</field>
        <field name="arch" type="xml">
            <form string="Vehicle Trip Record">
                <header>
                    <button name="action_complete_trip" string="Complete Trip" type="object" class="btn-primary" invisible="status != 'in_progress'"/>
                    <button name="action_verify_trip" string="Accounting Verify" type="object" class="btn-secondary" invisible="status != 'completed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,approved,in_progress,completed,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Trip Details">
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="passenger_name"/>
                            <field name="purpose"/>
                        </group>
                        <group string="Odometer &amp; Tenant Billing">
                            <field name="mileage_start"/>
                            <field name="mileage_end"/>
                            <field name="total_km"/>
                            <field name="is_chargeable"/>
                            <field name="chargeable_tenant_id"/>
                            <field name="trip_fee"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_trip_request" model="ir.actions.act_window">
        <field name="name">Fleet Trip Records</field>
        <field name="res_model">fleet.trip.request</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
