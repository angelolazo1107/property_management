<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Inheritance View for Governance & 3-Way Match -->
    <record id="purchase_order_form_governance_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.governance.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dept_head_approve" string="Dept Head PR Approval" type="object" class="btn-secondary" invisible="dept_head_approved"/>
                <button name="action_procurement_manager_approve" string="Approve Canvass (Procurement Mgr)" type="object" class="btn-secondary" invisible="procurement_manager_approved"/>
                <button name="action_gm_approve" string="Approve PO &amp; Sourcing (GM)" type="object" class="btn-primary" invisible="gm_po_approved"/>
                <button name="action_verify_three_way_match" string="Verify 3-Way Match Checkpoint" type="object" class="btn-success" invisible="three_way_match_verified"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="PR &amp; 3-Supplier Canvass Sheet" name="canvass_governance">
                    <group>
                        <group string="PR Reference &amp; Justification">
                            <field name="pr_reference"/>
                            <field name="pr_justification"/>
                            <field name="dept_head_approved"/>
                            <field name="dept_head_approver_id"/>
                        </group>
                        <group string="Strategic Sourcing &amp; 3-Supplier Canvass">
                            <field name="canvass_attachment" filename="canvass_file_name"/>
                            <field name="canvass_file_name" invisible="1"/>
                            <field name="supplier_1_name"/>
                            <field name="supplier_2_name"/>
                            <field name="supplier_3_name"/>
                            <field name="procurement_manager_approved"/>
                            <field name="gm_po_approved"/>
                        </group>
                    </group>
                    <group string="Repeat Order Verification">
                        <group>
                            <field name="is_repeat_order"/>
                            <field name="previous_po_id" invisible="not is_repeat_order"/>
                            <field name="price_increased" invisible="not is_repeat_order"/>
                        </group>
                    </group>
                    <group string="3-Way Match Checkpoint (PO + Goods Receipt + Vendor Invoice)">
                        <group>
                            <field name="goods_receipt_matched"/>
                            <field name="invoice_matched"/>
                            <field name="three_way_match_verified"/>
                            <field name="payment_request_cleared"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
