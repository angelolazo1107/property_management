<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_property_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.property.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dept_head_approve" string="Dept Head Approve" type="object" class="btn-primary" invisible="dept_head_approved"/>
                <button name="action_gm_approve" string="GM Approve (>50k)" type="object" class="btn-warning" invisible="gm_approved"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="pr_reference"/>
                <field name="canvass_attachment" filename="canvass_file_name"/>
                <field name="canvass_file_name" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Governance Approvals">
                    <group>
                        <field name="dept_head_approved"/>
                        <field name="dept_head_approver_id"/>
                    </group>
                    <group>
                        <field name="gm_approved"/>
                        <field name="gm_approver_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
