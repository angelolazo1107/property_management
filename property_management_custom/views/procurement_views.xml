<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_property_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.property.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dept_head_approve" string="Dept Head Approve" type="object" class="btn-primary" invisible="dept_head_approved"/>
                <button name="action_gm_approve" string="GM Approve (>50k)" type="object" class="btn-warning" invisible="gm_approved"/>
                <button name="action_verify_three_way_match" string="Verify 3-Way Match" type="object" class="btn-success" invisible="three_way_match_verified"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="pr_reference"/>
                <field name="canvass_attachment" filename="canvass_file_name"/>
                <field name="canvass_file_name" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Governance Approvals" name="governance_approvals">
                    <group>
                        <group string="Department Head Approval">
                            <field name="dept_head_approved"/>
                            <field name="dept_head_approver_id"/>
                        </group>
                        <group string="General Manager Approval">
                            <field name="gm_approved"/>
                            <field name="gm_approver_id"/>
                        </group>
                    </group>
                    <group string="Financial Control &amp; 3-Way Match">
                        <group>
                            <field name="three_way_match_verified"/>
                            <field name="payment_request_cleared"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
