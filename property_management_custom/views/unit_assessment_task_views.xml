<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Unit Assessment Task -->
    <record id="seq_unit_assessment_task" model="ir.sequence">
        <field name="name">Unit Assessment Task Sequence</field>
        <field name="code">unit.assessment.task</field>
        <field name="prefix">ASSESS-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Form View for unit.assessment.task -->
    <record id="view_unit_assessment_task_form" model="ir.ui.view">
        <field name="name">unit.assessment.task.form</field>
        <field name="model">unit.assessment.task</field>
        <field name="arch" type="xml">
            <form string="Unit Assessment &amp; Turnover Task (SARA Replacement)">
                <header>
                    <button name="action_assign_admin" 
                            type="object" 
                            string="Assign to Admin" 
                            class="btn-secondary" 
                            invisible="stage not in ('request_created')"/>

                    <button name="action_assign_housekeeping" 
                            type="object" 
                            string="Assign to Housekeeping" 
                            class="btn-secondary" 
                            invisible="stage not in ('request_created', 'assigned_admin')"/>

                    <button name="action_start_inspection" 
                            type="object" 
                            string="Start Inspection" 
                            class="btn-primary" 
                            invisible="stage in ('inspection_ongoing', 'ready_move_in')"/>

                    <button name="action_pass_assessment" 
                            type="object" 
                            string="Pass &amp; Set Ready for Move-In" 
                            class="btn-success" 
                            invisible="stage in ('ready_move_in')"/>

                    <button name="action_require_cleaning" 
                            type="object" 
                            string="Require Cleaning" 
                            class="btn-warning" 
                            invisible="stage in ('ready_move_in')"/>

                    <button name="action_require_repair" 
                            type="object" 
                            string="Require Repair" 
                            class="btn-danger" 
                            invisible="stage in ('ready_move_in')"/>

                    <field name="stage" widget="statusbar" statusbar_visible="request_created,assigned_admin,assigned_housekeeping,inspection_ongoing,ready_move_in"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Property Unit &amp; Inspection Assignment">
                            <field name="unit_id" options="{'no_create': True}"/>
                            <field name="tenant_id" options="{'no_create': True}"/>
                            <field name="inspection_date"/>
                            <field name="admin_user_id"/>
                            <field name="housekeeping_user_id"/>
                        </group>
                        <group string="Assessment Status &amp; Integration Links">
                            <field name="overall_assessment_result" widget="badge" 
                                   decoration-warning="overall_assessment_result == 'pending'" 
                                   decoration-success="overall_assessment_result == 'passed'" 
                                   decoration-danger="overall_assessment_result == 'failed'"/>
                            <field name="lease_contract_id"/>
                            <field name="opportunity_id"/>
                        </group>
                    </group>
                    <group string="11-Point Physical Unit Inspection Checklist">
                        <group string="Cleanliness &amp; General Structure">
                            <field name="unit_cleanliness_checked"/>
                            <field name="no_existing_damage_confirmed"/>
                            <field name="windows_checked"/>
                            <field name="door_lock_checked"/>
                        </group>
                        <group string="Utilities &amp; Appliances">
                            <field name="lights_working"/>
                            <field name="ac_checked"/>
                            <field name="plumbing_checked"/>
                            <field name="is_furnished_unit"/>
                            <field name="furniture_checked" invisible="not is_furnished_unit"/>
                        </group>
                    </group>
                    <group string="Dual Department Sign-Off &amp; Pre-Move-In Photos">
                        <group string="Sign-Off Approvals">
                            <field name="admin_approval"/>
                            <field name="housekeeping_approval"/>
                        </group>
                        <group string="Photo Audit Documentation">
                            <field name="pre_move_in_photos" filename="pre_move_in_photos_filename"/>
                            <field name="pre_move_in_photos_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inspection Findings &amp; Assessment Notes" name="assessment_notes">
                            <field name="notes" placeholder="Describe inspection observations, specific cleaning required, damage spots, or repair job order numbers..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View for unit.assessment.task -->
    <record id="view_unit_assessment_task_tree" model="ir.ui.view">
        <field name="name">unit.assessment.task.list</field>
        <field name="model">unit.assessment.task</field>
        <field name="arch" type="xml">
            <list string="Unit Assessment &amp; Turnover Tasks" decoration-info="stage in ('assigned_admin', 'assigned_housekeeping')" decoration-warning="stage in ('inspection_ongoing', 'cleaning_required')" decoration-danger="stage == 'repair_required'" decoration-success="stage == 'ready_move_in'">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="inspection_date"/>
                <field name="admin_user_id"/>
                <field name="housekeeping_user_id"/>
                <field name="admin_approval" widget="boolean"/>
                <field name="housekeeping_approval" widget="boolean"/>
                <field name="overall_assessment_result" widget="badge"/>
                <field name="stage" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Kanban View for unit.assessment.task -->
    <record id="view_unit_assessment_task_kanban" model="ir.ui.view">
        <field name="name">unit.assessment.task.kanban</field>
        <field name="model">unit.assessment.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="overall_assessment_result"/>
                <field name="stage"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><strong>Unit: </strong><field name="unit_id"/></div>
                                <div><strong>Tenant: </strong><field name="tenant_id"/></div>
                                <div><field name="overall_assessment_result" widget="badge"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Window for unit.assessment.task -->
    <record id="action_unit_assessment_task" model="ir.actions.act_window">
        <field name="name">Unit Assessment &amp; Turnover Tasks</field>
        <field name="res_model">unit.assessment.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Unit Assessment &amp; Turnover Task!
            </p>
            <p>
                Coordinate Admin and Housekeeping staff to inspect property units, verify physical cleanliness, damage-free condition, working utilities, dual approvals, and update unit status to Ready for Move-In.
            </p>
        </field>
    </record>
</odoo>
