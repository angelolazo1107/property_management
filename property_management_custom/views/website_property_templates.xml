<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Catalog / Showcase Template (/properties) -->
    <template id="property_catalog_template" name="Property Units Showcase">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Hero Header -->
                <div class="py-5 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
                    <div class="container text-center">
                        <h1 class="display-4 fw-bold mb-3">Available Property Units &amp; Commercial Spaces</h1>
                        <p class="lead text-white-50">Browse premium residential condo units and commercial spaces available for lease.</p>
                    </div>
                </div>

                <!-- Filter Bar -->
                <div class="container py-4">
                    <div class="card border-0 shadow-sm rounded-3 mb-4">
                        <div class="card-body p-3">
                            <form method="get" action="/properties" class="row g-3 align-items-center">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small text-muted">Filter by Occupancy Status</label>
                                    <select name="occupancy_status" class="form-select border-0 bg-light" onchange="this.form.submit()">
                                        <option value="" t-att-selected="not selected_occupancy">All Statuses</option>
                                        <option value="available" t-att-selected="selected_occupancy == 'available'">Available</option>
                                        <option value="reserved" t-att-selected="selected_occupancy == 'reserved'">Reserved</option>
                                        <option value="occupied" t-att-selected="selected_occupancy == 'occupied'">Occupied</option>
                                    </select>
                                </div>
                                <div class="col-md-8 text-end align-self-end">
                                    <a href="/property/inquiry" class="btn btn-primary px-4 fw-semibold rounded-pill">
                                        <i class="fa fa-envelope me-1"></i> Submit General Inquiry
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Property Cards Grid -->
                    <div class="row g-4">
                        <t t-if="not units">
                            <div class="col-12 text-center py-5">
                                <i class="fa fa-building-o fa-3x text-muted mb-3"></i>
                                <h4 class="text-muted">No property units match your current filter.</h4>
                                <a href="/properties" class="btn btn-outline-primary mt-2">View All Units</a>
                            </div>
                        </t>
                        <t t-foreach="units" t-as="unit">
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden transition-all">
                                    <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                                        <h5 class="card-title fw-bold mb-0 text-primary" t-field="unit.name"/>
                                        <span t-if="unit.occupancy_status == 'available'" class="badge bg-success px-3 py-2 rounded-pill">Available</span>
                                        <span t-if="unit.occupancy_status == 'reserved'" class="badge bg-warning text-dark px-3 py-2 rounded-pill">Reserved</span>
                                        <span t-if="unit.occupancy_status == 'occupied'" class="badge bg-secondary px-3 py-2 rounded-pill">Occupied</span>
                                        <span t-if="unit.occupancy_status not in ('available', 'reserved', 'occupied')" class="badge bg-info px-3 py-2 rounded-pill" t-field="unit.occupancy_status"/>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <small class="text-muted d-block">Floor Level</small>
                                                <span class="fw-semibold" t-esc="unit.floor_level or 'Standard'"/>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted d-block">Floor Area</small>
                                                <span class="fw-semibold" t-esc="'%.2f sqm' % unit.area_sqm if unit.area_sqm else 'N/A'"/>
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <small class="text-muted d-block">Electric Meter ID</small>
                                                <span class="small" t-esc="unit.electricity_meter_no or 'Unassigned'"/>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted d-block">Water Meter ID</small>
                                                <span class="small" t-esc="unit.water_meter_no or 'Unassigned'"/>
                                            </div>
                                        </div>
                                        <hr class="my-2"/>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <div>
                                                <small class="text-muted d-block">Monthly Lease Rate</small>
                                                <span class="fs-5 fw-bold text-dark" t-field="unit.list_price" t-options="{'widget': 'monetary', 'display_currency': unit.currency_id}"/>
                                            </div>
                                            <a t-attf-href="/property/inquiry?unit_id=#{unit.id}" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                                Inquire / Book Visit
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Property Inquiry & Ocular Visit Form Template (/property/inquiry) -->
    <template id="property_inquiry_form_template" name="Property Leasing Inquiry Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="py-5 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
                    <div class="container text-center">
                        <h1 class="display-4 fw-bold mb-2">Leasing Inquiry &amp; Ocular Visit Booking</h1>
                        <p class="lead text-white-50">Submit your property unit requirements or schedule an ocular site visit.</p>
                    </div>
                </div>

                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow rounded-3">
                                <div class="card-body p-4 p-md-5">
                                    <form action="/property/inquiry/submit" method="post" class="s_website_form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <h4 class="fw-bold text-primary mb-4 border-bottom pb-2">1. Contact &amp; Tenant Details</h4>
                                        <div class="row g-3 mb-4">
                                            <div class="col-md-12">
                                                <label class="form-label fw-semibold">Full Name / Company Name <span class="text-danger">*</span></label>
                                                <input type="text" name="contact_name" class="form-control" required="required" placeholder="e.g. Juan Dela Cruz"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                                <input type="email" name="email_from" class="form-control" required="required" placeholder="juan@example.com"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Mobile / Phone Number <span class="text-danger">*</span></label>
                                                <input type="tel" name="phone" class="form-control" required="required" placeholder="+63 917 123 4567"/>
                                            </div>
                                        </div>

                                        <h4 class="fw-bold text-primary mb-4 border-bottom pb-2">2. Property Unit Preferences</h4>
                                        <div class="row g-3 mb-4">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Target Property Unit</label>
                                                <select name="unit_id" class="form-select">
                                                    <option value="">Select a Property Unit (Optional)...</option>
                                                    <t t-foreach="units" t-as="u">
                                                        <option t-att-value="u.id" t-att-selected="selected_unit and selected_unit.id == u.id">
                                                            <t t-esc="u.name"/> (<t t-esc="'%.2f sqm' % u.area_sqm if u.area_sqm else 'N/A'"/> - <t t-esc="u.occupancy_status"/>)
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Target Move-In Date</label>
                                                <input type="date" name="intended_move_in_date" class="form-control"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Preferred Rent Budget (PHP)</label>
                                                <input type="number" step="0.01" name="preferred_budget" class="form-control" placeholder="25000.00"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Pet Registration Details</label>
                                                <input type="text" name="pet_details" class="form-control" placeholder="e.g. 1 Small Shih Tzu Breed"/>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-check mt-3">
                                                    <input type="checkbox" name="parking_required" id="parking_required" class="form-check-input"/>
                                                    <label for="parking_required" class="form-check-label fw-semibold">Parking Slot Required</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-check mt-3">
                                                    <input type="checkbox" name="wifi_required" id="wifi_required" class="form-check-input"/>
                                                    <label for="wifi_required" class="form-check-label fw-semibold">High-Speed Wi-Fi Connection Required</label>
                                                </div>
                                            </div>
                                        </div>

                                        <h4 class="fw-bold text-primary mb-4 border-bottom pb-2">3. Schedule Ocular Site Visit (Optional)</h4>
                                        <div class="row g-3 mb-4">
                                            <div class="col-md-12">
                                                <label class="form-label fw-semibold">Preferred Ocular Visit Date &amp; Time</label>
                                                <input type="datetime-local" name="ocular_visit_date" class="form-control"/>
                                                <small class="form-text text-muted">Selecting a date automatically notifies PMO security gate guards for visitor access.</small>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">Additional Remarks / Message</label>
                                            <textarea name="notes" class="form-control" rows="3" placeholder="Tell us more about your lease term or custom requirements..."></textarea>
                                        </div>

                                        <div class="text-end">
                                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                                                <i class="fa fa-paper-plane me-2"></i> Submit Leasing Inquiry
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Property Inquiry Thank You Template (/property/inquiry/thankyou) -->
    <template id="property_inquiry_thankyou_template" name="Property Inquiry Confirmation">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container py-5 text-center">
                    <div class="row justify-content-center py-5">
                        <div class="col-md-8 col-lg-6">
                            <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5">
                                <div class="mb-4">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle" style="width: 80px; height: 80px;">
                                        <i class="fa fa-check fa-3x"></i>
                                    </div>
                                </div>
                                <h2 class="fw-bold text-success mb-3">Leasing Inquiry Submitted Successfully!</h2>
                                <p class="lead text-muted mb-4">
                                    Thank you for your interest. Our leasing team has received your inquiry and will reach out to you shortly.
                                </p>
                                <t t-if="lead">
                                    <div class="alert alert-light border text-start mb-4">
                                        <small class="text-muted d-block">CRM Reference Lead</small>
                                        <strong t-esc="lead.name"/>
                                    </div>
                                </t>
                                <div>
                                    <a href="/properties" class="btn btn-primary px-4 rounded-pill me-2">Browse More Units</a>
                                    <a href="/" class="btn btn-outline-secondary px-4 rounded-pill">Return Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
