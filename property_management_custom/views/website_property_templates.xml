<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Catalog / Showcase Template (/properties) -->
    <template id="property_catalog_template" name="Property Units Showcase">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty" style="background-color: #0f172a; min-height: 100vh;">
                <!-- Luxury Hero Header -->
                <div class="py-5 position-relative overflow-hidden" style="background: radial-gradient(circle at 50% 20%, #1e293b 0%, #0f172a 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="container text-center py-4">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3" style="letter-spacing: 1.5px; font-size: 11px;">Exclusive Property Listings</span>
                        <h1 class="display-4 fw-extrabold mb-3 text-gold-gradient">Premium Commercial &amp; Residential Units</h1>
                        <p class="lead text-muted mx-auto" style="max-width: 650px;">Explore luxury residential condo units and prime commercial spaces available for immediate lease.</p>
                    </div>
                </div>

                <!-- Glassmorphism Filter Bar -->
                <div class="container py-4">
                    <div class="property-glass-card p-3 mb-5">
                        <form method="get" action="/properties" class="row g-3 align-items-center">
                            <div class="col-md-5">
                                <label class="form-label text-gold fw-semibold small text-uppercase mb-1">Filter Occupancy Status</label>
                                <select name="occupancy_status" class="form-select" onchange="this.form.submit()">
                                    <option value="" t-att-selected="not selected_occupancy">All Units &amp; Spaces</option>
                                    <option value="available" t-att-selected="selected_occupancy == 'available'">Available for Lease</option>
                                    <option value="reserved" t-att-selected="selected_occupancy == 'reserved'">Currently Reserved</option>
                                    <option value="occupied" t-att-selected="selected_occupancy == 'occupied'">Occupied</option>
                                </select>
                            </div>
                            <div class="col-md-7 text-md-end align-self-end mt-3 mt-md-0">
                                <a href="/property/inquiry" class="btn btn-gold-gradient px-4 py-2 rounded-pill">
                                    <i class="fa fa-envelope me-2"></i> Submit General Inquiry
                                </a>
                            </div>
                        </form>
                    </div>

                    <!-- Property Cards Grid -->
                    <div class="row g-4">
                        <t t-if="not units">
                            <div class="col-12 text-center py-5">
                                <i class="fa fa-building-o fa-4x text-gold opacity-50 mb-3"></i>
                                <h4 class="text-muted">No property units match your current filter.</h4>
                                <a href="/properties" class="btn btn-outline-gold mt-3 rounded-pill px-4">View All Units</a>
                            </div>
                        </t>
                        <t t-foreach="units" t-as="unit">
                            <div class="col-md-6 col-lg-4">
                                <div class="card property-glass-card h-100 overflow-hidden">
                                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                                        <h4 class="fw-bold mb-0 text-white" t-field="unit.name"/>
                                        <span t-if="unit.occupancy_status == 'available'" class="badge badge-available px-3 py-2 rounded-pill">Available</span>
                                        <span t-if="unit.occupancy_status == 'reserved'" class="badge badge-reserved px-3 py-2 rounded-pill">Reserved</span>
                                        <span t-if="unit.occupancy_status == 'occupied'" class="badge badge-occupied px-3 py-2 rounded-pill">Occupied</span>
                                        <span t-if="unit.occupancy_status not in ('available', 'reserved', 'occupied')" class="badge bg-info px-3 py-2 rounded-pill" t-field="unit.occupancy_status"/>
                                    </div>
                                    <div class="card-body px-4">
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <small class="text-muted d-block text-uppercase" style="font-size: 11px;">Floor Level</small>
                                                <span class="fw-semibold text-white" t-esc="unit.floor_level or 'Standard'"/>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted d-block text-uppercase" style="font-size: 11px;">Floor Area</small>
                                                <span class="fw-semibold text-white" t-esc="'%.2f sqm' % unit.area_sqm if unit.area_sqm else 'N/A'"/>
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <small class="text-muted d-block text-uppercase" style="font-size: 11px;">Electric Meter ID</small>
                                                <span class="small text-white-50" t-esc="unit.electricity_meter_no or 'Unassigned'"/>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted d-block text-uppercase" style="font-size: 11px;">Water Meter ID</small>
                                                <span class="small text-white-50" t-esc="unit.water_meter_no or 'Unassigned'"/>
                                            </div>
                                        </div>
                                        <hr style="border-color: rgba(255, 255, 255, 0.1);" class="my-3"/>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <div>
                                                <small class="text-muted d-block text-uppercase" style="font-size: 11px;">Monthly Rent</small>
                                                <span class="fs-4 fw-bold text-gold" t-field="unit.list_price" t-options="{'widget': 'monetary', 'display_currency': unit.currency_id}"/>
                                            </div>
                                            <a t-attf-href="/property/inquiry?unit_id=#{unit.id}" class="btn btn-outline-gold btn-sm px-3 rounded-pill">
                                                Inquire / Visit
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Property Inquiry & Ocular Visit Form Template (/property/inquiry) -->
    <template id="property_inquiry_form_template" name="Property Leasing Inquiry Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty" style="background-color: #0f172a; min-height: 100vh;">
                <div class="py-5 text-center" style="background: radial-gradient(circle at 50% 20%, #1e293b 0%, #0f172a 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="container">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3" style="letter-spacing: 1.5px; font-size: 11px;">Direct Tenant Concierge</span>
                        <h1 class="display-4 fw-bold mb-2 text-gold-gradient">Leasing Inquiry &amp; Ocular Visit Booking</h1>
                        <p class="lead text-muted mx-auto" style="max-width: 600px;">Submit your unit requirements or reserve a private ocular site visit with our leasing team.</p>
                    </div>
                </div>

                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="property-glass-card p-4 p-md-5">
                                <form action="/property/inquiry/submit" method="post" class="s_website_form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <h4 class="fw-bold text-gold mb-4 border-bottom pb-2" style="border-color: rgba(245, 158, 11, 0.3) !important;">
                                        <i class="fa fa-user me-2"></i> 1. Contact &amp; Personal Info
                                    </h4>
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-12">
                                            <label class="form-label fw-semibold">Full Name / Corporate Tenant <span class="text-gold">*</span></label>
                                            <input type="text" name="contact_name" class="form-control" required="required" placeholder="e.g. Juan Dela Cruz"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Email Address <span class="text-gold">*</span></label>
                                            <input type="email" name="email_from" class="form-control" required="required" placeholder="juan@example.com"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Mobile / Phone Number <span class="text-gold">*</span></label>
                                            <input type="tel" name="phone" class="form-control" required="required" placeholder="+63 917 123 4567"/>
                                        </div>
                                    </div>

                                    <h4 class="fw-bold text-gold mb-4 border-bottom pb-2" style="border-color: rgba(245, 158, 11, 0.3) !important;">
                                        <i class="fa fa-building me-2"></i> 2. Property Unit Specifications
                                    </h4>
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Target Property Unit</label>
                                            <select name="unit_id" class="form-select">
                                                <option value="">Select a Property Unit (Optional)...</option>
                                                <t t-foreach="units" t-as="u">
                                                    <option t-att-value="u.id" t-att-selected="selected_unit and selected_unit.id == u.id">
                                                        <t t-esc="u.name"/> (<t t-esc="'%.2f sqm' % u.area_sqm if u.area_sqm else 'N/A'"/> - <t t-esc="u.occupancy_status"/>)
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Target Move-In Date</label>
                                            <input type="date" name="intended_move_in_date" class="form-control"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Preferred Monthly Budget (PHP)</label>
                                            <input type="number" step="0.01" name="preferred_budget" class="form-control" placeholder="25000.00"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Pet Registration Details</label>
                                            <input type="text" name="pet_details" class="form-control" placeholder="e.g. 1 Small Shih Tzu Breed"/>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check-card">
                                                <div class="form-check">
                                                    <input type="checkbox" name="parking_required" id="parking_required" class="form-check-input"/>
                                                    <label for="parking_required" class="form-check-label text-white fw-semibold">Parking Slot Required</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check-card">
                                                <div class="form-check">
                                                    <input type="checkbox" name="wifi_required" id="wifi_required" class="form-check-input"/>
                                                    <label for="wifi_required" class="form-check-label text-white fw-semibold">High-Speed Wi-Fi Add-on</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <h4 class="fw-bold text-gold mb-4 border-bottom pb-2" style="border-color: rgba(245, 158, 11, 0.3) !important;">
                                        <i class="fa fa-calendar me-2"></i> 3. Schedule Private Ocular Visit
                                    </h4>
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-12">
                                            <label class="form-label fw-semibold">Preferred Ocular Visit Date &amp; Time</label>
                                            <input type="datetime-local" name="ocular_visit_date" class="form-control"/>
                                            <small class="text-muted mt-1 d-block">Selecting a visit time automatically creates a Security Visitor Gate Pass for site entry.</small>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">Additional Remarks / Message</label>
                                        <textarea name="notes" class="form-control" rows="3" placeholder="Tell us more about your business or lease term requirements..."></textarea>
                                    </div>

                                    <div class="text-end mt-4">
                                        <button type="submit" class="btn btn-gold-gradient btn-lg px-5 rounded-pill">
                                            <i class="fa fa-paper-plane me-2"></i> Submit Leasing Inquiry
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Property Inquiry Thank You Template (/property/inquiry/thankyou) -->
    <template id="property_inquiry_thankyou_template" name="Property Inquiry Confirmation">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty" style="background-color: #0f172a; min-height: 100vh;">
                <div class="container py-5 text-center">
                    <div class="row justify-content-center py-5">
                        <div class="col-md-8 col-lg-6">
                            <div class="property-glass-card p-4 p-md-5 text-center">
                                <div class="mb-4">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: rgba(16, 185, 129, 0.2); border: 2px solid #34d399;">
                                        <i class="fa fa-check fa-3x text-success"></i>
                                    </div>
                                </div>
                                <h2 class="fw-bold text-gold-gradient mb-3">Leasing Inquiry Received!</h2>
                                <p class="lead text-muted mb-4">
                                    Thank you for your interest. Our leasing concierge team has logged your inquiry and will reach out to you shortly.
                                </p>
                                <t t-if="lead">
                                    <div class="p-3 mb-4 rounded-3 text-start" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-glass);">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 11px;">CRM Reference Lead</small>
                                        <strong class="text-gold" t-esc="lead.name"/>
                                    </div>
                                </t>
                                <div>
                                    <a href="/properties" class="btn btn-gold-gradient px-4 rounded-pill me-2">Browse More Units</a>
                                    <a href="/" class="btn btn-outline-gold px-4 rounded-pill">Return Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
