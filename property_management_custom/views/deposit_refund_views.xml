<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Deposit Refund Form View -->
    <record id="view_security_deposit_refund_form" model="ir.ui.view">
        <field name="name">security.deposit.refund.form</field>
        <field name="model">security.deposit.refund</field>
        <field name="arch" type="xml">
            <form string="Security Deposit Refund &amp; Accounting Settlement">
                <header>
                    <button name="action_submit" string="Submit Application" type="object" class="btn-primary" invisible="finance_approval != 'pending'"/>
                    <button name="action_finance_approve" string="Approve Deposit Refund (Finance)" type="object" class="oe_highlight" invisible="finance_approval == 'approved'"/>
                    <button name="action_mark_paid" string="Mark Refund Paid / Completed" type="object" class="btn-success" invisible="payment_status == 'paid'"/>
                    <field name="payment_status" widget="statusbar" statusbar_visible="pending,in_payment,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not journal_entry_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Refund Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tenant &amp; Lease References">
                            <field name="lease_contract_id" options="{'no_create': True}"/>
                            <field name="move_out_clearance_id" options="{'no_create': True}"/>
                            <field name="tenant_id" options="{'no_create': True}"/>
                            <field name="unit_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Application Timeline (5-7 Working Days)">
                            <field name="refund_application_date"/>
                            <field name="expected_release_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Security Deposit Deductions &amp; Net Refund Summary">
                        <group string="Itemized Deductions">
                            <field name="currency_id" invisible="1"/>
                            <field name="original_security_deposit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="outstanding_rent_deduction" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="damage_deduction" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="utility_deduction" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="other_deduction" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Net Refund Summary &amp; Governance Status">
                            <field name="total_deduction" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"/>
                            <field name="refundable_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"/>
                            <field name="finance_approval" widget="badge" decoration-success="finance_approval == 'approved'" decoration-warning="finance_approval == 'pending'" decoration-danger="finance_approval == 'rejected'"/>
                        </group>
                    </group>
                    <group string="Tenant Bank Wire Credentials (Mandatory for Payout)">
                        <group>
                            <field name="bank_name" placeholder="e.g. BDO Unibank / BPI / Metrobank"/>
                            <field name="account_name" placeholder="e.g. Juan Dela Cruz"/>
                            <field name="account_number" placeholder="e.g. 0012-3456-7890"/>
                        </group>
                    </group>
                    <group string="Accounting Integration &amp; Proof of Refund Attachment">
                        <group string="Journal Entry Reference" invisible="not journal_entry_id">
                            <field name="journal_entry_id" readonly="1"/>
                        </group>
                        <group string="Proof of Payment Verification">
                            <field name="proof_of_refund_filename" invisible="1"/>
                            <field name="proof_of_refund" filename="proof_of_refund_filename" widget="binary" string="Proof of Refund Attachment *"/>
                        </group>
                    </group>
                    <group string="Remarks &amp; Wire Confirmation Notes">
                        <field name="notes" placeholder="Enter wire transfer reference number, bank receipt notes..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Security Deposit Refund List View -->
    <record id="view_security_deposit_refund_tree" model="ir.ui.view">
        <field name="name">security.deposit.refund.list</field>
        <field name="model">security.deposit.refund</field>
        <field name="arch" type="xml">
            <list string="Security Deposit Refunds">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="lease_contract_id"/>
                <field name="refund_application_date"/>
                <field name="expected_release_date"/>
                <field name="bank_name"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="original_security_deposit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_deduction" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="refundable_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="finance_approval" widget="badge" decoration-success="finance_approval == 'approved'" decoration-warning="finance_approval == 'pending'" decoration-danger="finance_approval == 'rejected'"/>
                <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-info="payment_status == 'in_payment'" decoration-warning="payment_status == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Security Deposit Refund Action -->
    <record id="action_security_deposit_refund" model="ir.actions.act_window">
        <field name="name">Security Deposit Refunds</field>
        <field name="res_model">security.deposit.refund</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Process a new Security Deposit Refund!
            </p>
            <p>
                Manage tenant security deposit refunds, bank wire detail verification, 5-7 working days release date engine, accounting liability settlements, and proof of payment receipt uploads.
            </p>
        </field>
    </record>
</odoo>
