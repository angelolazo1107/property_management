<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease Contract Form View -->
    <record id="view_lease_contract_form" model="ir.ui.view">
        <field name="name">lease.contract.form</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <form string="Tenant Lease Contract">
                <header>
                    <button name="action_verify_payment_clearance" string="Verify Payment &amp; Activate Lease" type="object" class="btn-primary" invisible="stage != 'payment_clearance'"/>
                    <button name="action_trigger_move_out" string="Trigger Move-Out Inspection" type="object" class="btn-warning" invisible="stage != 'active'"/>
                    <button name="action_approve_deposit_refund" string="Approve Security Deposit Refund" type="object" class="btn-success" invisible="deposit_refund_status == 'approved' or stage != 'move_out'"/>
                    <field name="stage" widget="statusbar" statusbar_visible="inquiry,reservation,bis_submitted,legal_review,payment_clearance,active,move_out,deposit_refund,terminated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tenant &amp; Unit Information">
                            <field name="tenant_id"/>
                            <field name="unit_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="monthly_rent"/>
                            <field name="security_deposit"/>
                        </group>
                        <group string="Contract Dates &amp; Clearances">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="bis_submitted"/>
                            <field name="legal_clearance"/>
                            <field name="deposit_paid"/>
                            <field name="move_in_checklist_done"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Move-Out Settlement &amp; Deposit Refund Ledger" name="deposit_ledger">
                            <group>
                                <group string="Deductions Calculation">
                                    <field name="unpaid_rent_deduction"/>
                                    <field name="utility_deduction"/>
                                    <field name="damage_deduction"/>
                                    <field name="cleaning_deduction"/>
                                    <field name="penalties_deduction"/>
                                    <field name="missing_items_deduction"/>
                                </group>
                                <group string="Refund Summary &amp; Governance Status">
                                    <field name="total_deductions" class="oe_subtotal_footer_separator"/>
                                    <field name="net_refund_amount" class="oe_subtotal_footer_separator"/>
                                    <field name="deposit_refund_status" widget="badge"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contract Notes &amp; Terms" name="notes">
                            <field name="notes" placeholder="Enter special contract stipulations, payment schedules, or renewal terms..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Lease Contract Tree View -->
    <record id="view_lease_contract_tree" model="ir.ui.view">
        <field name="name">lease.contract.tree</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <list string="Lease Contracts">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="monthly_rent"/>
                <field name="stage" widget="badge"/>
                <field name="deposit_paid"/>
                <field name="deposit_refund_status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Lease Contract Action -->
    <record id="action_lease_contract" model="ir.actions.act_window">
        <field name="name">Lease Package Contracts</field>
        <field name="res_model">lease.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
