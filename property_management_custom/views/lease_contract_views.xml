<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease Contract Form View -->
    <record id="view_lease_contract_form" model="ir.ui.view">
        <field name="name">lease.contract.form</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <form string="Tenant Lease Contract &amp; Legal Preparation">
                <header>
                    <button name="action_submit_tenant_review" 
                            type="object" 
                            string="Submit for Tenant Review" 
                            class="btn-secondary" 
                            invisible="stage not in ('draft')"/>

                    <button name="action_send_signing" 
                            type="object" 
                            string="Send for Signing" 
                            class="btn-primary" 
                            invisible="stage not in ('draft', 'tenant_review')"/>

                    <button name="action_tenant_signed" 
                            type="object" 
                            string="Mark Signed by Tenant" 
                            class="btn-success" 
                            invisible="stage not in ('for_signing')"/>

                    <button name="action_submit_billing" 
                            type="object" 
                            string="Submit to Billing" 
                            class="btn-info" 
                            invisible="stage not in ('signed_tenant')"/>

                    <button name="action_submit_legal" 
                            type="object" 
                            string="Forward to Legal for Notarization" 
                            class="btn-info" 
                            invisible="stage not in ('signed_tenant', 'submitted_billing')"/>

                    <button name="action_notarize" 
                            type="object" 
                            string="Notarize Contract" 
                            class="btn-success" 
                            invisible="stage not in ('submitted_legal', 'for_notarization')"/>

                    <button name="action_release_tenant" 
                            type="object" 
                            string="Release Executed Copy to Tenant" 
                            class="btn-primary" 
                            invisible="stage not in ('notarized')"/>

                    <button name="action_create_unit_assessment" 
                            type="object" 
                            string="Request Unit Assessment" 
                            class="btn-primary"/>

                    <button name="action_create_move_in_invoice" 
                            type="object" 
                            string="Create Move-In Settlement Invoice" 
                            class="btn-primary" 
                            invisible="move_in_invoice_id"/>

                    <button name="action_validate_move_in_readiness" 
                            type="object" 
                            string="Validate Move-In Readiness (9 Checkpoints)" 
                            class="btn-success" 
                            invisible="move_in_cleared"/>

                    <button name="action_trigger_move_out" 
                            type="object" 
                            string="Trigger Move-Out Inspection" 
                            class="btn-warning" 
                            invisible="stage != 'active'"/>

                    <button name="action_approve_deposit_refund" 
                            type="object" 
                            string="Approve Security Deposit Refund" 
                            class="btn-success" 
                            invisible="deposit_refund_status == 'approved' or stage != 'move_out'"/>

                    <button name="action_mark_renewed" 
                            type="object" 
                            string="Mark Renewed" 
                            class="btn-success" 
                            invisible="stage not in ('active', 'for_renewal', 'renewal_offered')"/>

                    <button name="action_mark_for_move_out" 
                            type="object" 
                            string="Mark For Move-Out (7-Day Notice)" 
                            class="btn-warning" 
                            invisible="stage not in ('active', 'for_renewal', 'renewal_offered')"/>

                    <button name="action_mark_breached" 
                            type="object" 
                            string="Mark Contract Breached" 
                            class="btn-danger" 
                            invisible="stage in ('draft', 'terminated', 'breached')"/>

                    <field name="stage" widget="statusbar" statusbar_visible="draft,active,for_renewal,renewal_offered,renewed,for_move_out,expired,terminated,breached"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_unit_assessments" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="unit_assessment_task_count" widget="statinfo" string="Unit Assessments"/>
                        </button>
                        <button name="action_view_move_in_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not move_in_invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Move-In Invoice</span>
                            </div>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Structured Contract Reference (LEASE-YYYY-PROPERTY-UNIT-SEQUENCE)"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tenant &amp; Lease Term Information">
                            <field name="tenant_id" options="{'no_create': True}"/>
                            <field name="unit_id" options="{'no_create': True}"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="contract_term_months"/>
                            <field name="payment_due_date"/>
                        </group>
                        <group string="Monthly Rental &amp; Recurring Billing Charges">
                            <field name="currency_id" invisible="1"/>
                            <field name="monthly_rent" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="security_deposit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="furniture_rental_fee" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="parking_fee" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="wifi_fee" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="pet_registration_fee" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="other_charges" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="reservation_fee_credit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <group string="Stage 11: Contract Signing &amp; Legal Processing Checklist (8 Required Items)">
                        <group>
                            <field name="reviewed_with_tenant" widget="boolean_toggle"/>
                            <field name="tenant_signed" widget="boolean_toggle"/>
                            <field name="house_rules_provided" widget="boolean_toggle"/>
                            <field name="violation_forms_provided" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="submitted_to_billing" widget="boolean_toggle"/>
                            <field name="forwarded_to_legal" widget="boolean_toggle"/>
                            <field name="notarized" widget="boolean_toggle"/>
                            <field name="tenant_received_notarized_copy" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Notarization &amp; Signed Attachments">
                            <field name="notary_status" widget="badge" decoration-warning="notary_status == 'pending'" decoration-success="notary_status == 'done'"/>
                            <field name="signed_copy" filename="signed_copy_filename"/>
                            <field name="signed_copy_filename" invisible="1"/>
                        </group>
                        <group string="Pipeline &amp; Reference Integrations">
                            <field name="bis_id"/>
                            <field name="opportunity_id"/>
                            <field name="move_in_invoice_id" readonly="1" invisible="not move_in_invoice_id"/>
                            <field name="move_in_invoice_payment_state" invisible="not move_in_invoice_id"/>
                        </group>
                    </group>
                    <group string="9-Checkpoint Move-In Readiness &amp; Clearance Gatekeeping">
                        <group>
                            <field name="bis_submitted" string="1. BIS Approved"/>
                            <field name="deposit_paid" string="2. Security Deposit Paid"/>
                            <field name="legal_clearance" string="3. Legal Clearance Approved"/>
                            <field name="move_in_checklist_done" string="4. Move-In Form Prepared"/>
                        </group>
                        <group>
                            <field name="move_in_cleared" readonly="1" widget="boolean_toggle"/>
                            <field name="move_in_cleared_date" invisible="not move_in_cleared"/>
                            <field name="exception_approved"/>
                            <field name="exception_reason" invisible="not exception_approved" required="exception_approved" placeholder="Enter GM or Operations exception approval authorization..."/>
                        </group>
                    </group>
                    <group string="Stage 18: Lease Expiration Monitoring &amp; Renewal Governance">
                        <group string="Expiration Audit &amp; Reminders">
                            <field name="days_until_expiry" widget="badge" decoration-danger="days_until_expiry &lt;= 7" decoration-warning="days_until_expiry &lt;= 30" decoration-info="days_until_expiry &lt;= 60" decoration-success="days_until_expiry &gt; 60"/>
                            <field name="renewal_decision"/>
                            <field name="is_holdover" invisible="1"/>
                        </group>
                        <group string="Notice &amp; Governance Controls">
                            <field name="notice_date"/>
                        </group>
                    </group>
                    <group string="Holdover Penalty Governance &amp; Calculation" invisible="renewal_decision != 'holdover'">
                        <group>
                            <field name="holdover_penalty_rate"/>
                            <field name="holdover_start_date"/>
                        </group>
                        <group>
                            <field name="holdover_monthly_rent" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Legal Clauses &amp; Policy Rules" name="legal_clauses">
                            <group>
                                <field name="renewal_terms" placeholder="Specify annual escalation rate (e.g. 5% renewal adjustment) and notice timeline..."/>
                                <field name="early_termination_clause" placeholder="Specify early exit penalty rules..."/>
                                <field name="deposit_forfeiture_rule" placeholder="Specify security deposit breach &amp; forfeiture conditions..."/>
                            </group>
                        </page>
                        <page string="Move-Out Settlement &amp; Deposit Refund Ledger" name="deposit_ledger">
                            <group>
                                <group string="Deductions Calculation">
                                    <field name="unpaid_rent_deduction"/>
                                    <field name="utility_deduction"/>
                                    <field name="damage_deduction"/>
                                    <field name="cleaning_deduction"/>
                                    <field name="penalties_deduction"/>
                                    <field name="missing_items_deduction"/>
                                </group>
                                <group string="Refund Summary &amp; Governance Status">
                                    <field name="total_deductions" class="oe_subtotal_footer_separator"/>
                                    <field name="net_refund_amount" class="oe_subtotal_footer_separator"/>
                                    <field name="deposit_refund_status" widget="badge"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contract Notes &amp; Special Terms" name="notes">
                            <field name="notes" placeholder="Enter special contract stipulations, payment schedules, or custom provisions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Lease Contract Tree View -->
    <record id="view_lease_contract_tree" model="ir.ui.view">
        <field name="name">lease.contract.tree</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <list string="Lease Contracts" decoration-info="stage in ('draft', 'tenant_review', 'for_signing')" decoration-warning="stage in ('signed_tenant', 'submitted_legal', 'for_notarization')" decoration-success="stage in ('notarized', 'released_tenant', 'active')" decoration-muted="stage in ('terminated', 'archived')">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="monthly_rent" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="notary_status" widget="badge"/>
                <field name="move_in_cleared" widget="boolean"/>
                <field name="stage" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Lease Contract Graph View -->
    <record id="view_lease_contract_graph" model="ir.ui.view">
        <field name="name">lease.contract.graph</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <graph string="Lease Contracts Analysis" type="bar">
                <field name="stage" type="row"/>
                <field name="monthly_rent" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Lease Contract Pivot View -->
    <record id="view_lease_contract_pivot" model="ir.ui.view">
        <field name="name">lease.contract.pivot</field>
        <field name="model">lease.contract</field>
        <field name="arch" type="xml">
            <pivot string="Lease Contracts Pivot Analysis">
                <field name="stage" type="row"/>
                <field name="payment_due_date" type="col"/>
                <field name="monthly_rent" type="measure"/>
                <field name="security_deposit" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Lease Contract Action -->
    <record id="action_lease_contract" model="ir.actions.act_window">
        <field name="name">Lease Package Contracts</field>
        <field name="res_model">lease.contract</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Tenant Lease Contract!
            </p>
            <p>
                Manage legal contract preparation, tenant review, signatures, notarization status, early termination policies, and strict 6-point move-in clearance controls.
            </p>
        </field>
    </record>
</odoo>
