<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access Request Form View -->
    <record id="view_access_request_form" model="ir.ui.view">
        <field name="name">access.request.form</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <form string="Access Card / Biometrics Application">
                <header>
                    <button name="action_submit" string="Submit Application" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_validate_payment" string="Validate Payment (Cashier)" type="object" class="btn-success" invisible="payment_status == 'paid'"/>
                    <button name="action_waive_payment" string="Waive Fee" type="object" class="btn-secondary" invisible="payment_status == 'waived'"/>
                    <button name="action_process" string="Move to Processing" type="object" class="btn-info" invisible="state != 'for_payment'"/>
                    <button name="action_release_card" string="Release Card / Grant Access" type="object" class="oe_highlight" invisible="state in ('completed', 'released')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,for_payment,for_processing,completed,released"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Customer Invoice</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Access Request Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Applicant &amp; Unit Details">
                            <field name="tenant_id" options="{'no_create': True}"/>
                            <field name="unit_id" options="{'no_create': True}"/>
                            <field name="access_type" widget="radio"/>
                            <field name="number_of_cards" invisible="access_type != 'access_card'"/>
                            <field name="unit_price" invisible="access_type != 'access_card'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="fee" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Payment &amp; Verification">
                            <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-info="payment_status == 'waived'" decoration-warning="payment_status == 'unpaid'"/>
                            <field name="invoice_id" readonly="1" invisible="not invoice_id"/>
                            <field name="invoice_payment_state" invisible="not invoice_id"/>
                            <field name="cashier_receipt_filename" invisible="1"/>
                            <field name="cashier_receipt" filename="cashier_receipt_filename" widget="binary"/>
                            <field name="valid_id_filename" invisible="1"/>
                            <field name="valid_id" filename="valid_id_filename" widget="binary"/>
                            <field name="released_card_number" placeholder="e.g. CARD-9901, CARD-9902" invisible="access_type != 'access_card' and not released_card_number"/>
                        </group>
                    </group>
                    <group string="Additional Notes">
                        <field name="notes" placeholder="Specify any additional instructions or special access permissions..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Access Request List View -->
    <record id="view_access_request_tree" model="ir.ui.view">
        <field name="name">access.request.list</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <list string="Access Card &amp; Biometrics Applications">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="access_type" widget="badge" decoration-info="access_type == 'biometrics'" decoration-primary="access_type == 'access_card'"/>
                <field name="number_of_cards"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="fee" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-info="payment_status == 'waived'" decoration-warning="payment_status == 'unpaid'"/>
                <field name="state" widget="badge" decoration-success="state in ('completed', 'released')" decoration-info="state == 'for_processing'" decoration-warning="state == 'for_payment'" decoration-muted="state == 'draft'"/>
                <field name="released_card_number"/>
            </list>
        </field>
    </record>

    <!-- Access Request Search View -->
    <record id="view_access_request_search" model="ir.ui.view">
        <field name="name">access.request.search</field>
        <field name="model">access.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="released_card_number"/>
                <filter string="Biometrics" name="filter_biometrics" domain="[('access_type', '=', 'biometrics')]"/>
                <filter string="Access Card" name="filter_access_card" domain="[('access_type', '=', 'access_card')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="For Payment" name="filter_for_payment" domain="[('state', '=', 'for_payment')]"/>
                <filter string="For Processing" name="filter_for_processing" domain="[('state', '=', 'for_processing')]"/>
                <filter string="Released / Completed" name="filter_released" domain="[('state', 'in', ['completed', 'released'])]"/>
                <separator/>
                <filter string="Unpaid" name="filter_unpaid" domain="[('payment_status', '=', 'unpaid')]"/>
                <filter string="Paid" name="filter_paid" domain="[('payment_status', '=', 'paid')]"/>
                <filter string="Waived" name="filter_waived" domain="[('payment_status', '=', 'waived')]"/>
                <group expand="0" string="Group By">
                    <filter string="Tenant" name="group_by_tenant" context="{'group_by': 'tenant_id'}"/>
                    <filter string="Unit" name="group_by_unit" context="{'group_by': 'unit_id'}"/>
                    <filter string="Access Type" name="group_by_access_type" context="{'group_by': 'access_type'}"/>
                    <filter string="Payment Status" name="group_by_payment_status" context="{'group_by': 'payment_status'}"/>
                    <filter string="Request Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Access Request Window Action -->
    <record id="action_access_request" model="ir.actions.act_window">
        <field name="name">Access Card / Biometrics Applications</field>
        <field name="res_model">access.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Access Card or Biometrics Request!
            </p>
            <p>
                Manage tenant access applications for physical access cards (PHP 300/card) or free biometrics registration.
            </p>
        </field>
    </record>
</odoo>
