<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agent Commission Form View -->
    <record id="view_agent_commission_form" model="ir.ui.view">
        <field name="name">agent.commission.form</field>
        <field name="model">agent.commission</field>
        <field name="arch" type="xml">
            <form string="Agent Commission Application &amp; Payout">
                <header>
                    <button name="action_submit" string="Submit Claim" type="object" class="oe_highlight" invisible="approval_status != 'draft'"/>
                    <button name="action_leasing_approve" string="Approve (Leasing Officer)" type="object" class="btn-success" invisible="approval_status != 'for_leasing_approval'"/>
                    <button name="action_finance_approve" string="Approve &amp; Create Vendor Bill (Finance)" type="object" class="oe_highlight" invisible="approval_status != 'for_finance_approval'"/>
                    <button name="action_reject" string="Reject Claim" type="object" class="btn-danger" invisible="approval_status in ('approved', 'paid', 'rejected')"/>
                    <field name="approval_status" widget="statusbar" statusbar_visible="draft,for_leasing_approval,for_finance_approval,approved,paid,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vendor_bill" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not vendor_bill_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Vendor Bill</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Claim Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Agent &amp; Lease Information">
                            <field name="agent_id" options="{'no_create': True}"/>
                            <field name="agent_type" widget="radio"/>
                            <field name="lease_contract_id" options="{'no_create': True}"/>
                            <field name="tenant_id" options="{'no_create': True}"/>
                            <field name="unit_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Commission Computation &amp; Verification">
                            <field name="commission_basis"/>
                            <field name="commission_percentage" invisible="commission_basis != 'percentage'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="commission_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="contract_signed" widget="boolean_toggle" readonly="1"/>
                            <field name="move_in_completed" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>
                    <group string="Agent Bank &amp; Payout Credentials (Mandatory)">
                        <group>
                            <field name="agent_bank_name" placeholder="e.g. BDO Unibank / BPI / Metrobank"/>
                            <field name="agent_bank_account_name" placeholder="e.g. Juan Dela Cruz / Realty Corp"/>
                            <field name="agent_bank_account_number" placeholder="e.g. 0012-3456-7890"/>
                        </group>
                        <group>
                            <field name="agent_valid_id_filename" invisible="1"/>
                            <field name="agent_valid_id" filename="agent_valid_id_filename" widget="binary" string="Agent Valid ID Attachment *"/>
                        </group>
                    </group>
                    <group string="Accounting Integration &amp; Vendor Bill Status" invisible="not vendor_bill_id">
                        <group>
                            <field name="vendor_bill_id" readonly="1"/>
                            <field name="vendor_bill_payment_state" widget="badge" decoration-success="vendor_bill_payment_state == 'paid'" decoration-info="vendor_bill_payment_state == 'in_payment'" decoration-warning="vendor_bill_payment_state == 'not_paid'"/>
                        </group>
                    </group>
                    <group string="Remarks &amp; Bank Routing Instructions">
                        <field name="notes" placeholder="Specify swift code, bank branch, or payout notes..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Agent Commission List View -->
    <record id="view_agent_commission_tree" model="ir.ui.view">
        <field name="name">agent.commission.list</field>
        <field name="model">agent.commission</field>
        <field name="arch" type="xml">
            <list string="Agent Commissions &amp; Payouts">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="agent_type" widget="badge" decoration-info="agent_type == 'internal'" decoration-primary="agent_type == 'outside'"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="lease_contract_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="commission_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="agent_bank_name"/>
                <field name="contract_signed" widget="boolean"/>
                <field name="approval_status" widget="badge" decoration-success="approval_status in ('approved', 'paid')" decoration-info="approval_status in ('for_leasing_approval', 'for_finance_approval')" decoration-warning="approval_status == 'draft'" decoration-danger="approval_status == 'rejected'"/>
                <field name="vendor_bill_payment_state" widget="badge" decoration-success="vendor_bill_payment_state == 'paid'" decoration-info="vendor_bill_payment_state == 'in_payment'" decoration-warning="vendor_bill_payment_state == 'not_paid'"/>
            </list>
        </field>
    </record>

    <!-- Agent Commission Window Action -->
    <record id="action_agent_commission" model="ir.actions.act_window">
        <field name="name">Agent Commissions &amp; Payouts</field>
        <field name="res_model">agent.commission</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submit a new Agent Commission Claim!
            </p>
            <p>
                Manage inside/outside agent commission applications, mandatory bank credentials verification, contract signing checks, and automated Vendor Bill creation for Finance payouts.
            </p>
        </field>
    </record>
</odoo>
