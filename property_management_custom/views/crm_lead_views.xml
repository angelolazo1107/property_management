<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CRM Lead Form View Extension for Stage 2 Ocular Visit Coordination -->
    <record id="view_crm_lead_form_property_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.property.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_schedule_ocular" string="Schedule Ocular" type="object" class="btn-primary" invisible="ocular_status in ('scheduled', 'completed')"/>
                <button name="action_complete_ocular" string="Complete Ocular" type="object" class="btn-success" invisible="ocular_status != 'scheduled'"/>
                <button name="action_create_quotation" string="Create Leasing Quotation" type="object" class="btn-primary"/>
                <button name="action_verify_bis" string="Verify BIS" type="object" class="btn-secondary" invisible="bis_status == 'verified'"/>
                <button name="action_verify_reservation_payment" string="Verify Reservation Fee (Accounting)" type="object" class="btn-primary" invisible="reservation_verified"/>
                <button name="action_verify_move_in_clearance" string="Grant Move-In Clearance" type="object" class="btn-success" invisible="move_in_cleared"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ocular_visits" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                    <field name="ocular_visit_count" widget="statinfo" string="Ocular Visits"/>
                </button>
                <button name="action_view_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="property_quotation_count" widget="statinfo" string="Quotations"/>
                </button>
                <button name="action_view_reservations" type="object" class="oe_stat_button" icon="fa-bookmark">
                    <field name="property_reservation_count" widget="statinfo" string="Reservations"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Leasing &amp; Tenant Requirements" name="leasing_details">
                    <group>
                        <group string="Unit &amp; Tenant Requirements">
                            <field name="target_unit_id"/>
                            <field name="intended_move_in_date"/>
                            <field name="preferred_budget"/>
                            <field name="parking_required"/>
                            <field name="wifi_required"/>
                            <field name="pet_details"/>
                            <field name="broker_id"/>
                        </group>
                        <group string="Ocular Visit &amp; Security Coordination">
                            <field name="ocular_visit_date"/>
                            <field name="ocular_status" widget="radio"/>
                            <field name="security_visitor_details"/>
                        </group>
                    </group>
                    <group string="Ocular Visits Scheduled">
                        <field name="ocular_visit_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="visitor_name"/>
                                <field name="contact_number"/>
                                <field name="visit_datetime"/>
                                <field name="agent_id"/>
                                <field name="unit_ids" widget="many2many_tags"/>
                                <field name="security_status" widget="badge"/>
                                <field name="status" widget="badge"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <group string="BIS &amp; Reservation Deposit">
                            <field name="bis_status" widget="radio"/>
                            <field name="reservation_proof" filename="reservation_proof_name"/>
                            <field name="reservation_proof_name" invisible="1"/>
                            <field name="reservation_verified"/>
                            <field name="official_receipt_no"/>
                            <field name="unit_hold_status"/>
                        </group>
                        <group string="Legal &amp; Move-In Financial Clearances">
                            <field name="legal_clearance"/>
                            <field name="move_in_cleared"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- CRM Opportunity Kanban View Extension -->
    <record id="crm_case_kanban_view_leads_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban.property.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="target_unit_id"/>
                <field name="ocular_status"/>
                <field name="unit_hold_status"/>
            </xpath>
        </field>
    </record>
</odoo>
