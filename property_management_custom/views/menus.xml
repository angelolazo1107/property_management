    <menuitem id="menu_crm_movein_gate_pass_cat"
              name="Move-In &amp; Gate Passes"
              parent="crm.crm_menu_root"
              sequence="12"/>

    <menuitem id="menu_move_in_form_crm"
              name="Move-In Processing Forms"
              parent="menu_crm_movein_gate_pass_cat"
              action="action_move_in_form"
              sequence="1"/>

    <menuitem id="menu_move_in_gate_pass_crm"
              name="Move-In Gate Passes"
              parent="menu_crm_movein_gate_pass_cat"
              action="action_move_in_gate_pass"
              sequence="2"/>

    <menuitem id="menu_visitor_gate_passes"
              name="Security Visitor Gate Passes"
              parent="menu_crm_movein_gate_pass_cat"
              action="action_visitor_gate_pass"
              sequence="3"/>

    <menuitem id="menu_rental_registration_summary_crm"
              name="Rental Registration Summaries"
              parent="menu_crm_movein_gate_pass_cat"
