              sequence="4"/>

    <menuitem id="menu_property_tenants"
              name="Tenants Master File"
              parent="menu_crm_movein_gate_pass_cat"
              action="action_property_tenant"
              sequence="5"/>

    <!-- ============================================================ -->
    <!-- 2. MAINTENANCE & PMO OPERATIONS (parent="maintenance.menu_m_request") -->
    <!-- ============================================================ -->
    <menuitem id="menu_pmo_root_custom"
              name="PMO Operations"
              parent="maintenance.menu_m_request"
              sequence="20"/>

    <menuitem id="menu_unit_assessment_task"
              name="Unit Assessments &amp; Turnover"
              parent="menu_pmo_root_custom"
              action="action_unit_assessment_task"
              sequence="1"/>

    <menuitem id="menu_pmo_inspections"
              name="Move-In / Out Inspections"
              parent="menu_pmo_root_custom"
              action="action_pmo_inspection"
              sequence="2"/>

    <menuitem id="menu_pmo_utility_readings"
              name="Electric &amp; Water Readings"
              parent="menu_pmo_root_custom"
              action="action_pmo_utility_reading"
              sequence="3"/>

    <menuitem id="menu_pmo_job_orders"
              name="Job Orders &amp; Maintenance"
              parent="menu_pmo_root_custom"
