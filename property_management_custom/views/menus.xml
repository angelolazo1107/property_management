    <!-- 3. ACCOUNTING & INVOICING APP (parent="account.menu_finance") -->
    <!-- ============================================================ -->
    <!-- Ensure root menu is labeled 'Accounting' on the main dashboard -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="name">Accounting</field>
    </record>

    <menuitem id="menu_property_accounting_root"
              name="Leasing Finance"
              parent="account.menu_finance"
              sequence="5"/>

    <menuitem id="menu_recurring_monthly_billing_acc"
              name="Monthly Billing &amp; Collections"
              parent="menu_property_accounting_root"
              action="action_recurring_monthly_billing"
              sequence="1"/>

    <menuitem id="menu_security_deposit_refund_acc"
              name="Security Deposit Refunds"
              parent="menu_property_accounting_root"
              action="action_security_deposit_refund"
              sequence="2"/>

    <menuitem id="menu_agent_commission_acc"
              name="Agent Commissions &amp; Payouts"
              parent="menu_property_accounting_root"
              action="action_agent_commission"
              sequence="3"/>

    <!-- ============================================================ -->
    <!-- 4. PURCHASES, FLEET & GOVERNANCE                           -->
    <!-- ============================================================ -->
    <menuitem id="menu_fleet_trips_custom"
              name="Vehicle Trips &amp; Fleet Logs"
              parent="fleet.menu_root"
              action="action_fleet_trip_request"
              sequence="10"/>

    <menuitem id="menu_office_supplies_custom"
              name="Office Supply Requisitions"
              parent="purchase.menu_purchase_root"
              action="action_office_supply_request"
              sequence="15"/>

    <menuitem id="menu_property_vendors_custom"
              name="Vendors &amp; Contractors"
              parent="purchase.menu_purchase_root"
              action="action_property_vendor"
              sequence="20"/>

    <menuitem id="menu_approval_matrix"
              name="Governance Approval Matrix"
              parent="base.menu_administration"
              action="action_approval_matrix"
              sequence="25"/>

    <menuitem id="menu_document_folders_custom"
              name="Document Folders Configuration"
              parent="base.menu_administration"
              action="action_property_document_category"
              sequence="30"/>
</odoo>
