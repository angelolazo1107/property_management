              parent="menu_pmo_root_custom"
              action="action_wifi_request"
              sequence="6"/>

    <menuitem id="menu_parking_application"
              name="Parking Applications &amp; Stickers"
              parent="menu_pmo_root_custom"
              action="action_parking_application"
              sequence="7"/>

    <menuitem id="menu_pet_registration"
              name="Pet Registrations &amp; Permits"
              parent="menu_pmo_root_custom"
              action="action_pet_registration"
              sequence="8"/>

