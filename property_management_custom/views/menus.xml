<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Document Category Window Action -->
    <record id="action_property_document_category" model="ir.actions.act_window">
        <field name="name">Document Management Folders</field>
        <field name="res_model">property.document.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- 1. CRM / LEASING SALES APP (parent="crm.crm_menu_root")       -->
    <!-- ============================================================ -->
    <!-- Category 1: Property Leasing -->
    <menuitem id="menu_crm_property_leasing_cat"
              name="Property Leasing"
              parent="crm.crm_menu_root"
              sequence="11"/>

    <menuitem id="menu_ocular_visits"
              name="Ocular Visit Coordination"
              parent="menu_crm_property_leasing_cat"
              action="action_ocular_visit"
              sequence="1"/>

    <menuitem id="menu_property_leasing_quotations"
              name="Leasing Quotations"
              parent="menu_crm_property_leasing_cat"
              action="sale.action_quotations_with_onboarding"
              sequence="2"/>

    <menuitem id="menu_property_reservations"
              name="Unit Reservations"
              parent="menu_crm_property_leasing_cat"
              action="action_property_reservation"
              sequence="3"/>

    <menuitem id="menu_tenant_application_bis"
              name="Tenant BIS Applications"
              parent="menu_crm_property_leasing_cat"
              action="action_tenant_application_bis"
              sequence="4"/>

    <menuitem id="menu_lease_contracts"
              name="Lease Contracts Pipeline"
              parent="menu_crm_property_leasing_cat"
              action="action_lease_contract"
              sequence="5"/>

