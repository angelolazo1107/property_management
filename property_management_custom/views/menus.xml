<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Document Category Window Action -->
    <record id="action_property_document_category" model="ir.actions.act_window">
        <field name="name">Document Management Folders</field>
        <field name="res_model">property.document.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 1. Leasing, Ocular Visit & Gate Pass Submenus Under CRM -->
    <menuitem id="menu_ocular_visits"
              name="Ocular Visit Coordination"
              parent="crm.crm_menu_root"
              action="action_ocular_visit"
              sequence="11"/>

    <menuitem id="menu_property_leasing_quotations"
              name="Leasing Quotations"
              parent="crm.crm_menu_root"
              action="sale.action_quotations_with_onboarding"
              sequence="12"/>

    <menuitem id="menu_visitor_gate_passes"
              name="Security Visitor Gate Passes"
              parent="crm.crm_menu_root"
              action="action_visitor_gate_pass"
              sequence="13"/>

    <menuitem id="menu_lease_contracts"
              name="Lease Contracts Pipeline"
              parent="crm.crm_menu_root"
              action="action_lease_contract"
              sequence="14"/>

    <menuitem id="menu_property_tenants"
              name="Tenants Master File"
              parent="crm.crm_menu_root"
              action="action_property_tenant"
              sequence="15"/>

    <!-- 2. PMO & Operations Custom Submenus Under Maintenance -->
    <menuitem id="menu_pmo_root_custom"
              name="PMO Operations"
              parent="maintenance.menu_m_request"
              sequence="20"/>

    <menuitem id="menu_pmo_inspections"
              name="Move-In / Out Inspections"
              parent="menu_pmo_root_custom"
              action="action_pmo_inspection"
              sequence="1"/>

    <menuitem id="menu_pmo_utility_readings"
              name="Electric &amp; Water Readings"
              parent="menu_pmo_root_custom"
              action="action_pmo_utility_reading"
              sequence="2"/>

    <menuitem id="menu_pmo_job_orders"
              name="Job Orders &amp; Maintenance"
              parent="menu_pmo_root_custom"
              action="action_pmo_job_order"
              sequence="3"/>

    <menuitem id="menu_approval_matrix"
              name="Governance Approval Matrix"
              parent="menu_pmo_root_custom"
              action="action_approval_matrix"
              sequence="4"/>

    <!-- 3. Admin, Supplies & Fleet Custom Submenus -->
    <menuitem id="menu_fleet_trips_custom"
              name="Vehicle Trips &amp; Fleet Logs"
              parent="fleet.menu_root"
              action="action_fleet_trip_request"
              sequence="10"/>

    <menuitem id="menu_office_supplies_custom"
              name="Office Supply Requisitions"
              parent="purchase.menu_purchase_root"
              action="action_office_supply_request"
              sequence="15"/>

    <menuitem id="menu_property_vendors_custom"
              name="Vendors &amp; Contractors"
              parent="purchase.menu_purchase_root"
              action="action_property_vendor"
              sequence="20"/>

    <menuitem id="menu_document_folders_custom"
              name="Document Folders Configuration"
              parent="base.menu_administration"
              action="action_property_document_category"
              sequence="30"/>
</odoo>
