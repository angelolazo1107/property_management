<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Building Tree View -->
    <record id="view_property_building_tree" model="ir.ui.view">
        <field name="name">property.building.tree</field>
        <field name="model">property.building</field>
        <field name="arch" type="xml">
            <list string="Buildings &amp; Complexes">
                <field name="code"/>
                <field name="name"/>
                <field name="address"/>
                <field name="total_floors"/>
                <field name="unit_count" string="Units Count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Property Building Form View -->
    <record id="view_property_building_form" model="ir.ui.view">
        <field name="name">property.building.form</field>
        <field name="model">property.building</field>
        <field name="arch" type="xml">
            <form string="Building / Complex">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Building / Tower Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Haraya Residences Tower 1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Building Details">
                            <field name="code" placeholder="e.g. HRT-01"/>
                            <field name="total_floors"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Location &amp; Address">
                            <field name="address" placeholder="Full address..."/>
                            <field name="unit_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Property Units in Building" name="building_units">
                            <field name="unit_ids">
                                <list string="Units">
                                    <field name="name"/>
                                    <field name="floor_level"/>
                                    <field name="area_sqm"/>
                                    <field name="property_type"/>
                                    <field name="list_price" string="Monthly Rent"/>
                                    <field name="occupancy_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Property Building Action -->
    <record id="action_property_building" model="ir.actions.act_window">
        <field name="name">Buildings &amp; Complexes</field>
        <field name="res_model">property.building</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Property Building or Complex!
            </p>
            <p>
                Define real estate towers and complexes to group individual units and commercial spaces.
            </p>
        </field>
    </record>
</odoo>
