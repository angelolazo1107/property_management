<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PMO Inspection Form View -->
    <record id="view_pmo_inspection_form" model="ir.ui.view">
        <field name="name">pmo.inspection.form</field>
        <field name="model">pmo.inspection</field>
        <field name="arch" type="xml">
            <form string="PMO Inspection Form">
                <header>
                    <button name="action_verify_inspection" string="Verify Inspection &amp; Update Unit Status" type="object" class="btn-primary" invisible="status == 'verified'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,submitted,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Inspection Details">
                            <field name="unit_id"/>
                            <field name="tenant_id"/>
                            <field name="lease_contract_id"/>
                            <field name="inspection_type" widget="radio"/>
                            <field name="inspection_date"/>
                            <field name="inspector_id"/>
                        </group>
                        <group string="Meter Readings &amp; Status">
                            <field name="electric_reading"/>
                            <field name="water_reading"/>
                            <field name="unit_condition" widget="radio"/>
                            <field name="unit_status_post_inspection"/>
                        </group>
                    </group>
                    <group string="Access Items Checklist (Keys, Cards, Remotes, Gate Passes &amp; Stickers)">
                        <group>
                            <field name="keys_count"/>
                            <field name="access_cards_count"/>
                            <field name="remotes_count"/>
                        </group>
                        <group>
                            <field name="gate_passes_count"/>
                            <field name="stickers_count"/>
                        </group>
                    </group>
                    <group string="Coordination Checkpoints">
                        <group>
                            <field name="info_desk_verified"/>
                            <field name="security_coordination"/>
                            <field name="wifi_parking_assigned"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Damage Findings &amp; Tenant Signature" name="findings">
                            <group>
                                <field name="chargeable_findings" placeholder="Record damages, missing items, or required PMO repairs..."/>
                                <field name="tenant_signature" widget="signature"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- PMO Inspection Tree View -->
    <record id="view_pmo_inspection_tree" model="ir.ui.view">
        <field name="name">pmo.inspection.tree</field>
        <field name="model">pmo.inspection</field>
        <field name="arch" type="xml">
            <list string="PMO Inspections">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="inspection_type"/>
                <field name="inspection_date"/>
                <field name="unit_condition" widget="badge"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
