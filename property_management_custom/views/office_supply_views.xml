<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_office_supply_request_tree" model="ir.ui.view">
        <field name="name">office.supply.request.list</field>
        <field name="model">office.supply.request</field>
        <field name="arch" type="xml">
            <list string="Office Supply Requisitions">
                <field name="name"/>
                <field name="department_id"/>
                <field name="requested_by_id"/>
                <field name="request_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_office_supply_request_form" model="ir.ui.view">
        <field name="name">office.supply.request.form</field>
        <field name="model">office.supply.request</field>
        <field name="arch" type="xml">
            <form string="Office Supply Requisition">
                <header>
                    <button name="action_dept_approve" string="Dept Head Approve" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,dept_approved,admin_review,released,pr_raised"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Requisition Info">
                            <field name="department_id"/>
                            <field name="requested_by_id"/>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested Supply Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_office_supply_request" model="ir.actions.act_window">
        <field name="name">Office Supply Requisitions</field>
        <field name="res_model">office.supply.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
