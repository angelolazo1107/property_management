<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Office Supply Request Form View -->
    <record id="view_office_supply_request_form" model="ir.ui.view">
        <field name="name">office.supply.request.form</field>
        <field name="model">office.supply.request</field>
        <field name="arch" type="xml">
            <form string="Office Supply Requisition">
                <header>
                    <button name="action_dept_approve" string="Approve (Dept Head)" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_admin_stock_check_available" string="Confirm Stock Available" type="object" class="btn-success" invisible="status != 'dept_approved'"/>
                    <button name="action_admin_stock_check_out" string="Out of Stock (Create PR)" type="object" class="btn-warning" invisible="status != 'dept_approved'"/>
                    <button name="action_release_supplies" string="Issue Supplies to Dept" type="object" class="btn-primary" invisible="stock_availability != 'available' or status == 'released'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,dept_approved,admin_review,released,pr_raised"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Requisition Info">
                            <field name="department_id"/>
                            <field name="requested_by_id"/>
                            <field name="request_date"/>
                        </group>
                        <group string="Stock Check &amp; PR Bridge">
                            <field name="stock_availability" widget="badge"/>
                            <field name="pr_reference" invisible="not pr_reference"/>
                            <field name="issuance_date"/>
                            <field name="issued_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Supplies Items List" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Office Supply Request Tree View -->
    <record id="view_office_supply_request_tree" model="ir.ui.view">
        <field name="name">office.supply.request.tree</field>
        <field name="model">office.supply.request</field>
        <field name="arch" type="xml">
            <list string="Office Supplies Requisitions">
                <field name="name"/>
                <field name="department_id"/>
                <field name="requested_by_id"/>
                <field name="request_date"/>
                <field name="stock_availability" widget="badge"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Office Supply Request Action -->
    <record id="action_office_supply_request" model="ir.actions.act_window">
        <field name="name">Office Supplies Requisitions</field>
        <field name="res_model">office.supply.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
