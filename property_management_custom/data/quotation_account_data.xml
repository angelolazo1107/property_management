        <record id="account_security_deposit_payable" model="account.account">
            <field name="name">Security Deposit Payable (Tenant Liabilities)</field>
            <field name="code">210200</field>
            <field name="account_type">liability_current</field>
        </record>
    </data>
</odoo>
