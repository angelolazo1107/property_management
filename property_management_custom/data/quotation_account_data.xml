<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Income Accounts for Property Leasing -->
        <record id="account_rental_income" model="account.account">
            <field name="name">Rental Income - Property Units</field>
            <field name="code">400100</field>
            <field name="account_type">income</field>
        </record>

        <record id="account_furniture_rental_income" model="account.account">
            <field name="name">Furniture Rental Income</field>
            <field name="code">400200</field>
            <field name="account_type">income</field>
        </record>

        <record id="account_parking_income" model="account.account">
            <field name="name">Parking Fee Income</field>
            <field name="code">400300</field>
