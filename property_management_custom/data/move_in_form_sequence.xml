<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Move-In Form Sequence -->
        <record id="seq_move_in_form" model="ir.sequence">
            <field name="name">Move-In Form Sequence</field>
            <field name="code">move.in.form</field>
            <field name="prefix">MIF-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Pet Registration Sequence -->
        <record id="seq_pet_registration" model="ir.sequence">
            <field name="name">Pet Registration Sequence</field>
            <field name="code">pet.registration</field>
            <field name="prefix">PET-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
