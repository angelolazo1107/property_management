<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Monthly Billing Sequence -->
        <record id="seq_recurring_monthly_billing" model="ir.sequence">
            <field name="name">Monthly Billing Sequence</field>
            <field name="code">recurring.monthly.billing</field>
            <field name="prefix">BILL-%(year)s-%(month)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
