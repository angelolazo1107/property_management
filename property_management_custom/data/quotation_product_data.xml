<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Monthly Rental Product -->
        <record id="product_monthly_rental" model="product.product">
            <field name="name">Monthly Rental</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">25000.00</field>
            <field name="description_sale">Monthly Base Lease Rate for Property Unit</field>
            <field name="property_account_income_id" ref="account_rental_income"/>
        </record>

        <!-- 2. Furniture Rental Product -->
        <record id="product_furniture_rental" model="product.product">
            <field name="name">Furniture Rental Fee</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">3500.00</field>
            <field name="description_sale">Monthly Furnishing &amp; Appliance Package Rental</field>
            <field name="property_account_income_id" ref="account_furniture_rental_income"/>
        </record>

        <!-- 3. Parking Fee Product -->
        <record id="product_parking_fee" model="product.product">
            <field name="name">Parking Space Rental Fee</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">5000.00</field>
            <field name="description_sale">Monthly Reserved Parking Slot Fee</field>
            <field name="property_account_income_id" ref="account_parking_income"/>
        </record>

        <!-- 4. Wi-Fi / Internet Fee Product -->
        <record id="product_wifi_fee" model="product.product">
            <field name="name">Wi-Fi / Internet Subscription Fee</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">2000.00</field>
            <field name="description_sale">High-Speed Fiber Wi-Fi Service Add-on</field>
            <field name="property_account_income_id" ref="account_internet_income"/>
        </record>

        <!-- 5. Access Card Fee Product -->
        <record id="product_access_card_fee" model="product.product">
            <field name="name">Building Access Card Fee</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">500.00</field>
            <field name="description_sale">RFID Security Gate &amp; Elevator Access Card</field>
            <field name="property_account_income_id" ref="account_access_card_income"/>
        </record>

        <!-- 6. Pet Registration Fee Product -->
        <record id="product_pet_registration_fee" model="product.product">
            <field name="name">Pet Registration &amp; Permit Fee</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">1500.00</field>
            <field name="description_sale">One-time Condo Pet Permit &amp; Registration Fee</field>
            <field name="property_account_income_id" ref="account_other_lease_income"/>
        </record>

        <!-- 7. Reservation Fee Product (Advance / Deposit) -->
        <record id="product_reservation_fee" model="product.product">
            <field name="name">Lease Reservation Deposit Fee</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">10000.00</field>
            <field name="description_sale">PHP 5,000 / PHP 10,000 Advance Unit Reservation Fee (Creditable towards first month rent / deposit)</field>
            <field name="property_account_income_id" ref="account_unearned_reservation_deposit"/>
        </record>

        <!-- 8. Security Deposit Product (Liability) -->
        <record id="product_security_deposit" model="product.product">
            <field name="name">Lease Security Deposit</field>
            <field name="type">service</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">50000.00</field>
            <field name="description_sale">Refundable Tenant Security Deposit (2 Months Rent equivalent)</field>
            <field name="property_account_income_id" ref="account_security_deposit_payable"/>
        </record>
    </data>
</odoo>
